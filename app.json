{
  "expo": {
    "name": "marcomobile",
    "slug": "marcomobile",
    "version": "0.0.1",
    "scheme": "marco",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/PRTS.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "La marco souhaiterait scanner un QRCode",
          "recordAudioAndroid": false
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-asset",
        {
          "assets": [
            "./assets/PRTS.png"
          ]
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
